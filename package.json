{
  "name": "fer-agent",
  "productName": "Fer Agent",
  "version": "9.2.0",
  "description": "Your AI agents live in a building: an open-source agentic company on your computer.",
  "author": "Fernando Villar Peláez",
  "homepage": "https://feragent.netlify.app",
  "license": "MIT",
  "type": "module",
  "main": "app/main.cjs",
  "scripts": {
    "app": "electron .",
    "home": "node fer-home.mjs",
    "installers": "electron-builder --publish never"
  },
  "dependencies": {
    "imapflow": "2.9.1",
    "mailparser": "3.12.4",
    "nodemailer": "10.2.1",
    "playwright-core": "1.63.0"
  },
  "devDependencies": {
    "electron": "44.10.2",
    "electron-builder": "26.18.0",
    "hoodiecrow-imap": "3.3.1",
    "smtp-server": "3.21.1"
  },
  "build": {
    "appId": "app.feragent.desktop",
    "productName": "Fer Agent",
    "copyright": "Copyright © 2026 Fernando Villar Peláez",
    "asar": false,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "app/**",
      "index.html",
      "app.js",
      "engine.js",
      "landing.js",
      "languages.js",
      "languages/**",
      "characters.js",
      "img/**",
      "fer-home.mjs",
      "hands.mjs",
      "skills/**",
      "build/icon.png",
      "package.json",
      "LICENSE"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "artifactName": "Fer-Agent-mac.${ext}",
      "category": "public.app-category.productivity",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "extendInfo": {
        "NSAppleEventsUsageDescription": "Fer Agent's agents use the buttons of your apps when you give them «Your computer as you»."
      }
    },
    "dmg": {
      "title": "Fer Agent"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "Fer-Agent-windows.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Fer Agent"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office",
      "maintainer": "Fernando Villar Peláez"
    },
    "artifactName": "Fer-Agent-${version}-${os}-${arch}.${ext}"
  }
}
